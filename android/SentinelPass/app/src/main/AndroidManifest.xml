<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions (WBS-817 audit):
         - USE_BIOMETRIC: platform-slot unlock (BiometricKeystore/BiometricPrompt).
         - INTERNET: relay sync (HTTPS-only, ADR-006; enforced by
           network_security_config below). No cleartext.
         - CAMERA was REMOVED: no QR scanner screen exists in the UI tree and
           no CameraX/ZXing API is referenced in any Kotlin source — the deps
           were removed from build.gradle.kts with it. Re-add both together
           if/when QR enrollment lands. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Features -->
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

    <application
        android:name=".SentinelPassApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SentinelPass"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SentinelPass">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WBS-813: auth/picker surface for the autofill flow. Never
             exported (the system launches it through OUR mutable
             PendingIntent, which carries our identity), excluded from
             recents, own task so it overlays the client app cleanly. -->
        <activity
            android:name=".autofill.AutofillUnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SentinelPass.Translucent" />

        <!-- WBS-813: confirmation surface for credentials captured by
             onSaveRequest. Same containment posture as the unlock activity. -->
        <activity
            android:name=".autofill.AutofillSaveActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SentinelPass.Translucent" />

        <!-- Autofill Service -->
        <service
            android:name=".autofill.SentinelPassAutofillService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.view.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_config" />
        </service>
    </application>

</manifest>
