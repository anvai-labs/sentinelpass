{
  "manifest_version": 3,
  "name": "SentinelPass",
  "version": "0.6.3",
  "description": "Secure, local-first password manager with autofill support",
  "permissions": [
    "storage",
    "activeTab",
    "notifications",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "autofill": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Trigger autofill"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sentinelpass@sentinelpass.org",
      "strict_min_version": "109.0"
    }
  }
}
