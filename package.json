{
  "name": "sentinelpass-web-tooling",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/anvai-labs/sentinelpass.git"
  },
  "scripts": {
    "web:build": "tsc -p tsconfig.web.json && node scripts/postprocess-web-build.mjs",
    "web:typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.extension.json --noEmit",
    "ext:build": "node scripts/build-extension.mjs",
    "test:ts": "vitest run --coverage",
    "test:ts:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "esbuild": "0.28.2"
  }
}
