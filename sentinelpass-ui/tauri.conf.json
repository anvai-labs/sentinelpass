{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SentinelPass",
  "version": "0.9.0",
  "identifier": "com.sentinelpass.app",
  "build": {
    "beforeDevCommand": "npm run web:build",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "SentinelPass",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none';"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "src-tauri/resources/bin/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
