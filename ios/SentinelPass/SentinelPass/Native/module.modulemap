// Canonical Swift/C module map for the SentinelPass mobile bridge.
//
// The header is a COPY of the generated contract at
// sentinelpass-mobile-bridge/include/sentinelpass_bridge.h (single source of
// truth; CI drift-checks the copy — regenerate with build-ios.sh or cbindgen).
//
// No `link` directive on purpose: the simulator and device static libraries
// have different names (…_ios_sim vs …_ios), so linking is selected per-SDK
// by the Xcode project's OTHER_LDFLAGS and, for SPM, by Package.swift's
// linkerSettings (.linkedLibrary).
module sentinelpass [system] [extern_c] {
    header "include/sentinelpass_bridge.h"
    export *
}
