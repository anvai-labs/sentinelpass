// Canonical Swift/C module map for the SentinelPass mobile bridge.
//
// The header is a COPY of the generated contract at
// sentinelpass-mobile-bridge/include/sentinelpass_bridge.h (single source of
// truth; CI drift-checks the copy — regenerate with build-ios.sh or cbindgen).
//
// The `link` directive names the SIMULATOR static library: this module map
// is consumed by SPM (swift build/test for iOS) and by the Xcode
// SPM-package scheme, both of which are simulator-only. The APP/extension
// targets do NOT use this map for linking — they select the per-SDK
// library via OTHER_LDFLAGS in the pbxproj (_ios_sim for simulators,
// _ios for devices).
module sentinelpass [system] [extern_c] {
    link "sentinelpass_mobile_bridge_ios_sim"
    header "include/sentinelpass_bridge.h"
    export *
}
