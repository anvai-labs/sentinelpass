<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WBS-825: the vault lives in the shared App Group container so the
	     SentinelPassCredential extension can open the same database. The
	     entitlement is declarative in the repo; provisioning/signing with a
	     real team is a user/CI concern (builds use CODE_SIGNING_ALLOWED=NO). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.sentinelpass</string>
	</array>
</dict>
</plist>
