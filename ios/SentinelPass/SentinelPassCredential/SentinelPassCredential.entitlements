<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WBS-825: shares the app's App Group so VaultFile resolves the same
	     vault path. No keychain-access-groups needed for the minimal
	     provider: it reads no keychain items. Declarative only; device
	     provisioning is a user/CI concern. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.sentinelpass</string>
	</array>
</dict>
</plist>
